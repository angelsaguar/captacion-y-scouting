GEMINI_API_KEY=
VITE_REGISTRATION_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
# Server-only Firebase Admin credentials for Vercel / production runtime.
# Store the complete service-account JSON as a secret environment variable.
# Never prefix this variable with VITE_ and never expose its value to the browser.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Auth UID of the authorized club administrator (server only).
CLUB_ADMIN_FIREBASE_UID=
